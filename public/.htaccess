# Mudanzas360 en Hostinger como web estática (sin Node). Todas las páginas están
# prerenderizadas en carpetas con su index.html: /portes/chamberi/ -> portes/chamberi/index.html

Options -MultiViews -Indexes
DirectoryIndex index.html
DirectorySlash On

# Cualquier dirección que no exista devuelve la página 404 con su código 404.
ErrorDocument 404 /404/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # La 404 no se indexa (además lleva noindex en la propia página).
  RewriteRule ^404/?$ - [L]
</IfModule>

<IfModule mod_headers.c>
  # Archivos con hash en el nombre: un año de caché.
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML, sitemap, robots y llms.txt: se revisan cada hora.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "^404\.html$|index\.html$">
    Header append Vary "Accept-Encoding"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml text/plain image/svg+xml
</IfModule>
